---
// ヘッダー右の行き先。Starlight の SocialIcons を差し替える
import { stripBase, withBase } from '../lib/base';
const path = stripBase(Astro.url.pathname);
const links = [
  { href: withBase('/'), label: '地図', current: path === '/' || path.startsWith('/map/') },
  { href: withBase('/links/'), label: 'リンク', current: path.startsWith('/links') },
];
---
<nav class="topnav" aria-label="サイト内の行き先">
  {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
</nav>
